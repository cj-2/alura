<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Lista de Produtos</title>
  </head>
  <body>
    <table>
      <tr>
        <td>ID</td>
        <td>NOME</td>
        <td>DESCRIÇÃO</td>
        <td>PREÇO</td>
      </tr>
      <tr>
        <td>1</td>
        <td>Livro de node.js</td>
      </tr>
      <% lista.forEach(function(item){ %>
        <tr>
          <td><%= item.id; %></td>
          <td><%= item.titulo; %></td>
          <td><%= item.descricao; %></td>
          <td><%= item.preco; %></td>
        </tr>
      <% }); %>
    </table>
  </body>
</html>
